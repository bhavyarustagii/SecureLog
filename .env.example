# SecureLog Environment Configuration Template
# Copy this file to .env and customize for your environment.
# Never commit .env with actual credentials.

# Application Settings
SECURELOG_APP_NAME=SecureLog
SECURELOG_ENV=development
SECURELOG_DEBUG=false
SECURELOG_LOG_LEVEL=INFO

# Storage & Evidence Directories
SECURELOG_DATA_DIR=data
SECURELOG_EVIDENCE_DIR=data/evidence
SECURELOG_DB_PATH=data/securelog.db
SECURELOG_LOG_PATH=data/securelog.jsonl

# Capture Settings
CAPTURE_INTERFACE=Wi-Fi
SECURELOG_CAPTURE_BACKEND=pyshark
SECURELOG_CAPTURE_ENABLED=true

# WebSockets & API
SECURELOG_WEBSOCKET_ENABLED=true
SECURELOG_WEBSOCKET_PATH=/ws/events

# Blockchain (Ganache / EVM)
SECURELOG_BLOCKCHAIN_ENABLED=true
GANACHE_URL=http://127.0.0.1:7545
SECURELOG_CONTRACT_ADDRESS=

# Database & Retention Settings
SECURELOG_SQLITE_BUSY_TIMEOUT_MS=5000
SECURELOG_EVENT_RETENTION_DAYS=30

# Telegram Alerting (Optional)
TELEGRAM_ENABLED=false
TELEGRAM_BOT_TOKEN=YOUR_TELEGRAM_BOT_TOKEN_HERE
TELEGRAM_CHAT_ID=YOUR_TELEGRAM_CHAT_ID_HERE
TELEGRAM_MIN_LEVEL=3

# SMTP Email Alerting (Optional)
EMAIL_ENABLED=false
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
EMAIL_SENDER=your_email@gmail.com
EMAIL_PASSWORD=your_app_password_here
EMAIL_RECIPIENT=admin@example.com
